	if err != nil {
		return nil, fmt.Errorf("invalid user ID: %w", err)
	}

	id, err := uuid.Parse(highlightID)
	if err != nil {
		return nil, fmt.Errorf("invalid highlight ID: %w", err)
	}

	// Fetch existing highlight to verify ownership
	highlight, err := r.HighlightRepo.GetByID(ctx, id)
	if err != nil {
		return nil, fmt.Errorf("highlight not found: %w", err)
	}

	// Check ownership
	if highlight.UserID != userID {
		return nil, fmt.Errorf("unauthorized: highlight belongs to different user")
	}

	// Hard delete (matches TypeScript behavior)
	if err := r.HighlightRepo.Delete(ctx, id); err != nil {
		return nil, fmt.Errorf("failed to delete highlight: %w", err)
	}

	return &model.DeleteHighlightResult{
		Success: true,
	}, nil
}

// UpdatePage is the resolver for the updatePage field.
func (r *mutationResolver) UpdatePage(ctx context.Context, input model.UpdatePageInput) (model.UpdatePageResult, error) {
	// Get authenticated user
	user, hasUser := db.GetUserFromContext(ctx)
	if !hasUser {
		return nil, fmt.Errorf("unauthorized: no user in context")
	}

	userID, err := uuid.Parse(user.ID)
	if err != nil {
		return nil, fmt.Errorf("invalid user ID: %w", err)
	}

	pageID, err := uuid.Parse(input.PageID)
	if err != nil {
		return nil, fmt.Errorf("invalid page ID: %w", err)
	}

	// Fetch existing library item
	item, err := r.LibraryItemRepo.GetByID(ctx, pageID)
	if err != nil {
		return nil, fmt.Errorf("library item not found: %w", err)
	}

	// Check ownership
	if item.UserID != userID {
		return nil, fmt.Errorf("unauthorized: library item belongs to different user")
	}

	// Update fields (partial update)
	if input.Title != nil {
		item.Title = input.Title
	}
	if input.Description != nil {
		item.Description = input.Description
	}
	if input.ReadingProgressPercent != nil {
		item.ReadingProgressPercent = *input.ReadingProgressPercent
	}
	if input.State != nil {
		item.State = dbmodel.LibraryItemState(*input.State)

		// Set state-specific timestamps
		now := time.Now()
		switch *input.State {
		case model.LibraryItemStateArchived:
			item.ArchivedAt = &now
		}
	}
	if input.SavedAt != nil {
		savedAt, err := time.Parse(time.RFC3339, *input.SavedAt)
		if err != nil {
			return nil, fmt.Errorf("invalid savedAt format: %w", err)
		}
		item.SavedAt = savedAt
	}

	// Save updates using repository method
	if err := r.LibraryItemRepo.Update(ctx, item); err != nil {
		return nil, fmt.Errorf("failed to update library item: %w", err)
	}

	return &model.UpdatePageResult{
		Success: true,
	}, nil
}

