		highlight.Annotation = input.Annotation
	}
	if input.Color != nil {
		highlight.Color = input.Color
	}

	if err := r.HighlightRepo.Update(ctx, highlight); err != nil {
		return nil, fmt.Errorf("failed to update highlight: %w", err)
	}

	// Convert to GraphQL model
	gqlHighlight := &model.Highlight{
		ID:         highlight.ID.String(),
		Quote:      highlight.Quote,
		Annotation: highlight.Annotation,
		Color:      highlight.Color,
		CreatedAt:  highlight.CreatedAt.Format(time.RFC3339),
		UpdatedAt:  highlight.UpdatedAt.Format(time.RFC3339),
	}

	return &model.UpdateHighlightResult{
		Highlight: gqlHighlight,
	}, nil
}

