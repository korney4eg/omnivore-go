		}
		labelIDs[i] = labelID
	}

	// Set labels on library item
	if err := r.LibraryItemRepo.SetLabels(ctx, pageID, labelIDs); err != nil {
		return nil, fmt.Errorf("failed to set labels: %w", err)
	}

	// Fetch updated labels
	labels, err := r.LabelRepo.GetByIDs(ctx, labelIDs)
	if err != nil {
		return nil, fmt.Errorf("failed to fetch labels: %w", err)
	}

	// Convert to GraphQL model
	gqlLabels := make([]*model.Label, len(labels))
	for i, label := range labels {
		gqlLabels[i] = &model.Label{
			ID:          label.ID.String(),
			Name:        label.Name,
			Color:       label.Color,
			Description: label.Description,
		}
	}

	return &model.SetLabelsResult{
		Labels: gqlLabels,
	}, nil
}

