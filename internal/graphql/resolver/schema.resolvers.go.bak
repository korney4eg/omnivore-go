// Me is the resolver for the me field.
func (r *queryResolver) Me(ctx context.Context) (*model.User, error) {
	// Get user from context (set by auth middleware)
	user, hasUser := db.GetUserFromContext(ctx)
	if !hasUser {
		return nil, fmt.Errorf("unauthorized: no user in context")
	}

	// Fetch full user with profile from database
	dbUser, err := r.UserRepo.GetByID(ctx, uuid.MustParse(user.ID))
	if err != nil {
		return nil, fmt.Errorf("failed to get user: %w", err)
	}

	// Convert to GraphQL model
	gqlUser := &model.User{
		ID:    dbUser.ID.String(),
		Name:  dbUser.Name,
		Email: &dbUser.Email,
	}

	if dbUser.Profile != nil {
		gqlUser.Profile = &model.Profile{
			ID:       dbUser.Profile.ID.String(),
			Username: dbUser.Profile.Username,
		}
		if dbUser.Profile.Bio != nil {
			gqlUser.Profile.Bio = dbUser.Profile.Bio
		}
		if dbUser.Profile.PictureURL != nil {
			gqlUser.Profile.PictureURL = dbUser.Profile.PictureURL
		}
	}

	return gqlUser, nil
}

// Article is the resolver for the article field.
func (r *queryResolver) Article(ctx context.Context, id *string, slug *string) (model.ArticleResult, error) {
	// Must provide either id or slug
	if id == nil && slug == nil {
		return nil, fmt.Errorf("must provide either id or slug")
	}

	var dbItem *dbmodel.LibraryItem
	var err error

	if id != nil {
		itemID, parseErr := uuid.Parse(*id)
		if parseErr != nil {
			return nil, fmt.Errorf("invalid id format: %w", parseErr)
		}
		dbItem, err = r.LibraryItemRepo.GetByID(ctx, itemID)
	} else {
		dbItem, err = r.LibraryItemRepo.GetBySlug(ctx, *slug)
	}

	if err != nil {
		return nil, fmt.Errorf("failed to get article: %w", err)
	}

	// Convert to GraphQL model
	gqlItem := &model.LibraryItem{
		ID:                     dbItem.ID.String(),
		Slug:                   dbItem.Slug,
		URL:                    dbItem.OriginalURL,
		State:                  model.LibraryItemState(dbItem.State),
		SavedAt:                dbItem.SavedAt.Format(time.RFC3339),
		ReadingProgressPercent: dbItem.ReadingProgressPercent,
		Folder:                 dbItem.Folder,
		Labels:                 make([]*model.Label, 0),
		Highlights:             make([]*model.Highlight, 0),
	}

	if dbItem.Title != nil {
		gqlItem.Title = dbItem.Title
	}
	if dbItem.Author != nil {
		gqlItem.Author = dbItem.Author
	}
	if dbItem.Description != nil {
		gqlItem.Description = dbItem.Description
	}
	if dbItem.Thumbnail != nil {
		gqlItem.Thumbnail = dbItem.Thumbnail
	}
	if dbItem.ReadAt != nil {
		readAt := dbItem.ReadAt.Format(time.RFC3339)
		gqlItem.ReadAt = &readAt
	}
	if dbItem.ArchivedAt != nil {
		archivedAt := dbItem.ArchivedAt.Format(time.RFC3339)
		gqlItem.ArchivedAt = &archivedAt
	}

	// Convert labels
	for _, label := range dbItem.Labels {
		gqlItem.Labels = append(gqlItem.Labels, &model.Label{
			ID:    label.ID.String(),
			Name:  label.Name,
			Color: label.Color,
		})
	}

	// Convert highlights
	for _, highlight := range dbItem.Highlights {
		gqlHighlight := &model.Highlight{
			ID:        highlight.ID.String(),
			CreatedAt: highlight.CreatedAt.Format(time.RFC3339),
			UpdatedAt: highlight.UpdatedAt.Format(time.RFC3339),
		}
		if highlight.Quote != nil {
			gqlHighlight.Quote = highlight.Quote
		}
		if highlight.Annotation != nil {
			gqlHighlight.Annotation = highlight.Annotation
		}
		if highlight.Color != nil {
			gqlHighlight.Color = highlight.Color
		}
		gqlItem.Highlights = append(gqlItem.Highlights, gqlHighlight)
	}

	return gqlItem, nil
}

// Labels is the resolver for the labels field.
func (r *queryResolver) Labels(ctx context.Context) ([]*model.Label, error) {
	// Get user from context
	user, hasUser := db.GetUserFromContext(ctx)
	if !hasUser {
		return nil, fmt.Errorf("unauthorized: no user in context")
	}

	userID, err := uuid.Parse(user.ID)
	if err != nil {
		return nil, fmt.Errorf("invalid user id: %w", err)
	}

	// Fetch labels from database
	dbLabels, err := r.LabelRepo.GetByUserID(ctx, userID)
	if err != nil {
		return nil, fmt.Errorf("failed to get labels: %w", err)
	}

	// Convert to GraphQL models
	gqlLabels := make([]*model.Label, 0, len(dbLabels))
	for _, label := range dbLabels {
		gqlLabel := &model.Label{
			ID:    label.ID.String(),
			Name:  label.Name,
			Color: label.Color,
		}
		if label.Description != nil {
			gqlLabel.Description = label.Description
		}
		gqlLabels = append(gqlLabels, gqlLabel)
	}

	return gqlLabels, nil
}

// Highlights is the resolver for the highlights field.
func (r *queryResolver) Highlights(ctx context.Context, libraryItemID *string) ([]*model.Highlight, error) {
	// Get user from context
	user, hasUser := db.GetUserFromContext(ctx)
	if !hasUser {
		return nil, fmt.Errorf("unauthorized: no user in context")
	}

	var dbHighlights []*dbmodel.Highlight
	var err error

	if libraryItemID != nil {
		// Get highlights for specific library item
		itemID, parseErr := uuid.Parse(*libraryItemID)
		if parseErr != nil {
			return nil, fmt.Errorf("invalid library item id: %w", parseErr)
		}
		dbHighlights, err = r.HighlightRepo.GetByLibraryItemID(ctx, itemID)
	} else {
		// Get all highlights for user
		userID, parseErr := uuid.Parse(user.ID)
		if parseErr != nil {
			return nil, fmt.Errorf("invalid user id: %w", parseErr)
		}
		dbHighlights, err = r.HighlightRepo.GetByUserID(ctx, userID)
	}

	if err != nil {
		return nil, fmt.Errorf("failed to get highlights: %w", err)
	}

	// Convert to GraphQL models
	gqlHighlights := make([]*model.Highlight, 0, len(dbHighlights))
	for _, highlight := range dbHighlights {
		gqlHighlight := &model.Highlight{
			ID:        highlight.ID.String(),
			CreatedAt: highlight.CreatedAt.Format(time.RFC3339),
			UpdatedAt: highlight.UpdatedAt.Format(time.RFC3339),
		}
		if highlight.Quote != nil {
			gqlHighlight.Quote = highlight.Quote
		}
		if highlight.Annotation != nil {
			gqlHighlight.Annotation = highlight.Annotation
		}
		if highlight.Color != nil {
			gqlHighlight.Color = highlight.Color
		}
		gqlHighlights = append(gqlHighlights, gqlHighlight)
	}

	return gqlHighlights, nil
}

// Subscriptions is the resolver for the subscriptions field.
func (r *queryResolver) Subscriptions(ctx context.Context, sort *model.SortParams, typeArg *dbmodel.SubscriptionType) ([]*dbmodel.Subscription, error) {
	// Get authenticated user from context
	user, hasUser := db.GetUserFromContext(ctx)
	if !hasUser {
		return nil, fmt.Errorf("unauthorized: no user in context")
	}

	userID, err := uuid.Parse(user.ID)
	if err != nil {
		return nil, fmt.Errorf("invalid user ID: %w", err)
	}

	// Parse sort parameters
	sortBy := "created_at"
	sortOrder := "DESC"
	if sort != nil {
		if sort.By != nil {
			switch *sort.By {
			case model.SortByUpdatedTime:
				sortBy = "refreshed_at"
			case model.SortByCreatedTime:
				sortBy = "created_at"
			}
		}
		if sort.Order != nil {
			switch *sort.Order {
			case model.SortOrderAscending:
				sortOrder = "ASC"
			case model.SortOrderDescending:
				sortOrder = "DESC"
			}
		}
	}

	// Query subscriptions with type filter and sorting
	subscriptions, err := r.SubscriptionRepo.FindByUserID(ctx, userID, typeArg, sortBy, sortOrder)
	if err != nil {
		return nil, fmt.Errorf("failed to fetch subscriptions: %w", err)
	}

	// Convert to pointer slice for GraphQL
	result := make([]*dbmodel.Subscription, len(subscriptions))
	for i := range subscriptions {
		result[i] = &subscriptions[i]
	}

	return result, nil
}

// Search is the resolver for the search field.
func (r *queryResolver) Search(ctx context.Context, after *string, first *int32, query *string, includeContent *bool) (model.SearchResult, error) {
	// Get authenticated user from context
	user, hasUser := db.GetUserFromContext(ctx)
	if !hasUser {
		return nil, fmt.Errorf("unauthorized: no user in context")
	}

	userID, err := uuid.Parse(user.ID)
	if err != nil {
		return nil, fmt.Errorf("invalid user ID: %w", err)
	}

	// Build search params
	searchParams := service.SearchParams{
		UserID:         userID,
		After:          after,
		IncludeContent: includeContent != nil && *includeContent,
	}

	if query != nil {
		searchParams.Query = *query
	}

	if first != nil {
		firstInt := int(*first)
		searchParams.First = &firstInt
	}

	// Execute search
	result, err := r.SearchService.Search(ctx, searchParams)
	if err != nil {
		return nil, fmt.Errorf("search failed: %w", err)
	}

	// Convert to GraphQL model
	edges := make([]*model.ArticleEdge, len(result.Items))
	for i, item := range result.Items {
		// Convert LibraryItem to GraphQL model
		gqlItem := &model.LibraryItem{
			ID:                     item.ID.String(),
			Slug:                   item.Slug,
			Title:                  item.Title,
			Author:                 item.Author,
			Description:            item.Description,
			URL:                    item.OriginalURL,
			Thumbnail:              item.Thumbnail,
			State:                  model.LibraryItemState(item.State),
			SavedAt:                item.SavedAt.Format(time.RFC3339),
			ReadingProgressPercent: item.ReadingProgressPercent,
			Folder:                 item.Folder,
		}

		if item.ReadAt != nil {
			readAt := item.ReadAt.Format(time.RFC3339)
			gqlItem.ReadAt = &readAt
		}
		if item.ArchivedAt != nil {
			archivedAt := item.ArchivedAt.Format(time.RFC3339)
			gqlItem.ArchivedAt = &archivedAt
		}

		// Convert labels
		if item.Labels != nil {
			gqlItem.Labels = make([]*model.Label, len(item.Labels))
			for j, label := range item.Labels {
				gqlItem.Labels[j] = &model.Label{
					ID:          label.ID.String(),
					Name:        label.Name,
					Color:       label.Color,
					Description: label.Description,
				}
			}
		}

		// Convert highlights
		if item.Highlights != nil {
			gqlItem.Highlights = make([]*model.Highlight, len(item.Highlights))
			for j, hl := range item.Highlights {
				gqlItem.Highlights[j] = &model.Highlight{
					ID:         hl.ID.String(),
					Quote:      hl.Quote,
					Annotation: hl.Annotation,
					Color:      hl.Color,
					CreatedAt:  hl.CreatedAt.Format(time.RFC3339),
					UpdatedAt:  hl.UpdatedAt.Format(time.RFC3339),
				}
			}
		}

		cursor := fmt.Sprintf("%d", i)
		edges[i] = &model.ArticleEdge{
			Node:   gqlItem,
			Cursor: cursor,
		}
	}

	// Convert TotalCount to int32
	var totalCount32 *int32
	if result.TotalCount != nil {
		tc := int32(*result.TotalCount)
		totalCount32 = &tc
	}

	return &model.ArticlesResult{
		Edges: edges,
		PageInfo: &model.PageInfo{
			HasNextPage:     result.HasNextPage,
			HasPreviousPage: result.HasPreviousPage,
			StartCursor:     result.StartCursor,
			EndCursor:       result.EndCursor,
			TotalCount:      totalCount32,
		},
	}, nil
}

