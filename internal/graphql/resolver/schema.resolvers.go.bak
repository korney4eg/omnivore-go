	if err != nil {
		return nil, fmt.Errorf("invalid user ID: %w", err)
	}

	pageID, err := uuid.Parse(input.PageID)
	if err != nil {
		return nil, fmt.Errorf("invalid page ID: %w", err)
	}

	// Verify library item ownership
	item, err := r.LibraryItemRepo.GetByID(ctx, pageID)
	if err != nil {
		return nil, fmt.Errorf("library item not found: %w", err)
	}
	if item.UserID != userID {
		return nil, fmt.Errorf("unauthorized: library item belongs to different user")
	}

	// Parse label IDs
	labelIDs := make([]uuid.UUID, len(input.LabelIds))
	for i, id := range input.LabelIds {
		labelID, err := uuid.Parse(id)
		if err != nil {
