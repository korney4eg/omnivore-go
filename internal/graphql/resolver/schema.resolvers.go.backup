// UpdatePage is the resolver for the updatePage field.
func (r *mutationResolver) UpdatePage(ctx context.Context, input model.UpdatePageInput) (model.UpdatePageResult, error) {
// Get authenticated user
user, hasUser := db.GetUserFromContext(ctx)
if !hasUser {
return &model.UpdatePageError{
ErrorCodes: []model.UpdatePageErrorCode{model.UpdatePageErrorCodeUnauthorized},
}, nil
}

userID, err := uuid.Parse(user.ID)
if err != nil {
return &model.UpdatePageError{
ErrorCodes: []model.UpdatePageErrorCode{model.UpdatePageErrorCodeBadRequest},
}, nil
}

pageID, err := uuid.Parse(input.PageID)
if err != nil {
return &model.UpdatePageError{
ErrorCodes: []model.UpdatePageErrorCode{model.UpdatePageErrorCodeBadRequest},
}, nil
}

// Fetch existing library item
item, err := r.LibraryItemRepo.FindByID(ctx, userID, pageID)
if err != nil {
return &model.UpdatePageError{
ErrorCodes: []model.UpdatePageErrorCode{model.UpdatePageErrorCodeNotFound},
}, nil
}

// Update fields
if input.Title != nil {
item.Title = *input.Title
}
if input.Description != nil {
item.Description = input.Description
}
if input.SavedAt != nil {
item.SavedAt = *input.SavedAt
}
if input.PublishedAt != nil {
item.PublishedAt = input.PublishedAt
}

if err := r.LibraryItemRepo.Update(ctx, item); err != nil {
return &model.UpdatePageError{
ErrorCodes: []model.UpdatePageErrorCode{model.UpdatePageErrorCodeUnknown},
}, nil
}

// Fetch updated library item with labels
updatedItem, err := r.LibraryItemRepo.FindByID(ctx, userID, pageID)
if err != nil {
return &model.UpdatePageError{
ErrorCodes: []model.UpdatePageErrorCode{model.UpdatePageErrorCodeUnknown},
}, nil
}

// Fetch labels for the item
labels, err := r.LabelRepo.FindByLibraryItemID(ctx, userID, pageID)
if err != nil {
return &model.UpdatePageError{
ErrorCodes: []model.UpdatePageErrorCode{model.UpdatePageErrorCodeUnknown},
}, nil
}

// Convert labels to GraphQL models
var gqlLabels []*model.Label
for _, label := range labels {
gqlLabels = append(gqlLabels, &model.Label{
ID:          label.ID.String(),
Name:        label.Name,
Color:       label.Color,
Description: label.Description,
CreatedAt:   &label.CreatedAt,
})
}

// Convert to GraphQL library item
gqlItem := &model.LibraryItem{
ID:          updatedItem.ID.String(),
Title:       updatedItem.Title,
Description: updatedItem.Description,
SiteName:    updatedItem.SiteName,
OriginalURL: updatedItem.OriginalURL,
URL:         updatedItem.Slug,
SavedAt:     &updatedItem.SavedAt,
PublishedAt: updatedItem.PublishedAt,
CreatedAt:   &updatedItem.CreatedAt,
UpdatedAt:   &updatedItem.UpdatedAt,
State:       updatedItem.State,
Labels:      gqlLabels,
}

return &model.UpdatePageSuccess{
UpdatedPage: gqlItem,
}, nil
}

