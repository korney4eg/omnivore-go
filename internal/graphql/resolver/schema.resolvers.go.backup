// Me is the resolver for the me field.
func (r *queryResolver) Me(ctx context.Context) (*model.User, error) {
// Get user from context (already authenticated by auth middleware)
user, hasUser := db.GetUserFromContext(ctx)
if !hasUser {
return nil, fmt.Errorf("no user in context")
}

// Parse user ID
userID, err := uuid.Parse(user.ID)
if err != nil {
return nil, fmt.Errorf("invalid user ID: %w", err)
}

// Fetch user from database
dbUser, err := r.UserRepo.FindByID(ctx, userID)
if err != nil {
return nil, fmt.Errorf("failed to fetch user: %w", err)
}

// Convert to GraphQL model
return &model.User{
ID:        dbUser.ID.String(),
Name:      dbUser.Name,
Email:     &dbUser.Email,
SourceID:  dbUser.SourceUserID,
CreatedAt: &dbUser.CreatedAt,
Profile: model.Profile{
Username: dbUser.Profile.Username,
},
}, nil
}

// Article is the resolver for the article field.
func (r *queryResolver) Article(ctx context.Context, id *string, slug *string) (model.ArticleResult, error) {
// Get authenticated user
user, hasUser := db.GetUserFromContext(ctx)
if !hasUser {
return nil, fmt.Errorf("unauthorized: no user in context")
}

userID, err := uuid.Parse(user.ID)
if err != nil {
return nil, fmt.Errorf("invalid user ID: %w", err)
}

// Validate inputs
if id == nil && slug == nil {
return nil, fmt.Errorf("either id or slug must be provided")
}

var item *dbmodel.LibraryItem

// Fetch by ID or slug
if id != nil {
itemID, err := uuid.Parse(*id)
if err != nil {
return nil, fmt.Errorf("invalid article ID: %w", err)
}
item, err = r.LibraryItemRepo.FindByID(ctx, userID, itemID)
if err != nil {
return nil, fmt.Errorf("article not found: %w", err)
}
} else {
item, err = r.LibraryItemRepo.FindBySlug(ctx, userID, *slug)
if err != nil {
return nil, fmt.Errorf("article not found: %w", err)
}
}

// Fetch labels for the item
labels, err := r.LabelRepo.FindByLibraryItemID(ctx, userID, item.ID)
if err != nil {
return nil, fmt.Errorf("failed to fetch labels: %w", err)
}

// Fetch highlights for the item
highlights, err := r.HighlightRepo.FindByLibraryItemID(ctx, userID, item.ID)
if err != nil {
return nil, fmt.Errorf("failed to fetch highlights: %w", err)
}

// Convert labels to GraphQL models
var gqlLabels []*model.Label
for _, label := range labels {
gqlLabels = append(gqlLabels, &model.Label{
ID:          label.ID.String(),
Name:        label.Name,
Color:       label.Color,
Description: label.Description,
CreatedAt:   &label.CreatedAt,
})
}

// Convert highlights to GraphQL models
var gqlHighlights []*model.Highlight
for _, highlight := range highlights {
gqlHighlight := &model.Highlight{
ID:        highlight.ID.String(),
Quote:     highlight.Quote,
Patch:     highlight.Patch,
ShortID:   highlight.ShortID,
CreatedAt: &highlight.CreatedAt,
UpdatedAt: &highlight.UpdatedAt,
}
if highlight.Annotation != nil {
gqlHighlight.Annotation = highlight.Annotation
}
if highlight.Prefix != nil {
gqlHighlight.Prefix = highlight.Prefix
}
if highlight.Suffix != nil {
gqlHighlight.Suffix = highlight.Suffix
}
if highlight.HighlightType != nil {
gqlHighlight.Type = highlight.HighlightType
}
if highlight.HighlightColor != nil {
gqlHighlight.Color = highlight.HighlightColor
}
gqlHighlights = append(gqlHighlights, gqlHighlight)
}

// Convert to GraphQL library item
return &model.LibraryItem{
ID:          item.ID.String(),
Title:       item.Title,
Description: item.Description,
SiteName:    item.SiteName,
OriginalURL: item.OriginalURL,
URL:         item.Slug,
SavedAt:     &item.SavedAt,
PublishedAt: item.PublishedAt,
CreatedAt:   &item.CreatedAt,
UpdatedAt:   &item.UpdatedAt,
State:       item.State,
Labels:      gqlLabels,
Highlights:  gqlHighlights,
}, nil
}

