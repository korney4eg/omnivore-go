CreatedAt:   &label.CreatedAt,
})
}

return gqlLabels, nil
}

// Highlights is the resolver for the highlights field.
func (r *queryResolver) Highlights(ctx context.Context, libraryItemID *string) ([]*model.Highlight, error) {
// Get authenticated user
user, hasUser := db.GetUserFromContext(ctx)
if !hasUser {
return nil, fmt.Errorf("unauthorized: no user in context")
}

userID, err := uuid.Parse(user.ID)
if err != nil {
return nil, fmt.Errorf("invalid user ID: %w", err)
}

var highlights []*dbmodel.Highlight

if libraryItemID != nil {
// Fetch highlights for specific library item
itemID, err := uuid.Parse(*libraryItemID)
if err != nil {
return nil, fmt.Errorf("invalid library item ID: %w", err)
}
highlights, err = r.HighlightRepo.FindByLibraryItemID(ctx, userID, itemID)
if err != nil {
return nil, fmt.Errorf("failed to fetch highlights: %w", err)
}
} else {
// Fetch all highlights for user
highlights, err = r.HighlightRepo.FindByUserID(ctx, userID)
if err != nil {
return nil, fmt.Errorf("failed to fetch highlights: %w", err)
}
}

// Convert to GraphQL models
var gqlHighlights []*model.Highlight
for _, highlight := range highlights {
gqlHighlight := &model.Highlight{
ID:        highlight.ID.String(),
Quote:     highlight.Quote,
Patch:     highlight.Patch,
ShortID:   highlight.ShortID,
CreatedAt: &highlight.CreatedAt,
UpdatedAt: &highlight.UpdatedAt,
}
if highlight.Annotation != nil {
gqlHighlight.Annotation = highlight.Annotation
}
if highlight.Prefix != nil {
gqlHighlight.Prefix = highlight.Prefix
}
if highlight.Suffix != nil {
gqlHighlight.Suffix = highlight.Suffix
}
if highlight.HighlightType != nil {
gqlHighlight.Type = highlight.HighlightType
}
if highlight.HighlightColor != nil {
gqlHighlight.Color = highlight.HighlightColor
}
gqlHighlights = append(gqlHighlights, gqlHighlight)
}

return gqlHighlights, nil
}

// Subscriptions is the resolver for the subscriptions field.
func (r *queryResolver) Subscriptions(ctx context.Context, sort *model.SortParams, typeArg *dbmodel.SubscriptionType) ([]*dbmodel.Subscription, error) {
// Get authenticated user
user, hasUser := db.GetUserFromContext(ctx)
if !hasUser {
return nil, fmt.Errorf("unauthorized: no user in context")
}

userID, err := uuid.Parse(user.ID)
if err != nil {
return nil, fmt.Errorf("invalid user ID: %w", err)
}

// Set defaults
sortBy := "UPDATED_TIME"
sortOrder := "DESCENDING"
if sort != nil {
if sort.By != nil {
sortBy = string(*sort.By)
}
if sort.Order != nil {
sortOrder = string(*sort.Order)
}
}

// Fetch subscriptions
subscriptions, err := r.SubscriptionRepo.FindByUserID(ctx, userID, sortBy, sortOrder, typeArg)
if err != nil {
return nil, fmt.Errorf("failed to fetch subscriptions: %w", err)
}

return subscriptions, nil
}

// Search is the resolver for the search field.
func (r *queryResolver) Search(ctx context.Context, after *string, first *int32, query *string, includeContent *bool) (model.SearchResult, error) {
// Get authenticated user
user, hasUser := db.GetUserFromContext(ctx)
if !hasUser {
return &model.SearchError{
ErrorCodes: []model.SearchErrorCode{model.SearchErrorCodeUnauthorized},
}, nil
}

userID, err := uuid.Parse(user.ID)
if err != nil {
return &model.SearchError{
ErrorCodes: []model.SearchErrorCode{model.SearchErrorCodeBadRequest},
}, nil
}

// Set defaults
limit := int32(10)
if first != nil {
limit = *first
}

searchQuery := ""
if query != nil {
searchQuery = *query
}

// Parse cursor
var afterTime *time.Time
if after != nil && *after != "" {
cursor, err := uuid.Parse(*after)
if err != nil {
return &model.SearchError{
ErrorCodes: []model.SearchErrorCode{model.SearchErrorCodeBadRequest},
}, nil
}
// Fetch the library item to get its savedAt timestamp
cursorItem, err := r.LibraryItemRepo.FindByID(ctx, userID, cursor)
if err == nil {
afterTime = &cursorItem.SavedAt
}
}

// Search library items
items, err := r.LibraryItemRepo.Search(ctx, userID, searchQuery, afterTime, int(limit)+1)
if err != nil {
return &model.SearchError{
ErrorCodes: []model.SearchErrorCode{model.SearchErrorCodeUnknown},
}, nil
}

// Check if there are more items
hasNextPage := len(items) > int(limit)
if hasNextPage {
items = items[:limit]
}

// Convert to edges
edges := make([]*model.SearchItemEdge, len(items))
for i, item := range items {
// Fetch labels for each item
labels, err := r.LabelRepo.FindByLibraryItemID(ctx, userID, item.ID)
if err != nil {
return &model.SearchError{
ErrorCodes: []model.SearchErrorCode{model.SearchErrorCodeUnknown},
}, nil
}

// Convert labels to GraphQL models
var gqlLabels []*model.Label
for _, label := range labels {
gqlLabels = append(gqlLabels, &model.Label{
ID:          label.ID.String(),
Name:        label.Name,
Color:       label.Color,
Description: label.Description,
CreatedAt:   &label.CreatedAt,
})
}

// Convert to GraphQL library item
gqlItem := &model.LibraryItem{
ID:          item.ID.String(),
Title:       item.Title,
Description: item.Description,
SiteName:    item.SiteName,
OriginalURL: item.OriginalURL,
URL:         item.Slug,
SavedAt:     &item.SavedAt,
PublishedAt: item.PublishedAt,
CreatedAt:   &item.CreatedAt,
UpdatedAt:   &item.UpdatedAt,
State:       item.State,
Labels:      gqlLabels,
}

edges[i] = &model.SearchItemEdge{
Cursor: item.ID.String(),
Node:   gqlItem,
}
}

// Build page info
var endCursor *string
if len(edges) > 0 {
endCursor = &edges[len(edges)-1].Cursor
}

pageInfo := &model.PageInfo{
HasNextPage: hasNextPage,
EndCursor:   endCursor,
}

return &model.SearchSuccess{
Edges:    edges,
PageInfo: pageInfo,
}, nil
}

